# ─────────────────────────────────────────────────────────────────────────────
# AgentHub — master environment configuration
#
# Copy this file to .env and fill in every value before using the CLI:
#
#   cp .env.example .env
#
# This file is intentionally committed (no secrets). .env is gitignored.
# ─────────────────────────────────────────────────────────────────────────────


# ─── Master Wallet ────────────────────────────────────────────────────────────
# Private key of the master account (hex, 0x-prefixed).
# Used to:
#   • Pay gas for on-chain agent registrations (npm run register inside each agent)
#   • Sign give-feedback transactions from the AgentHub CLI
# Keep this key funded with native tokens on whichever chain you use.
PRIVATE_KEY=0x_your_master_wallet_private_key_here


# ─── IPFS / Pinata ───────────────────────────────────────────────────────────
# JWT from https://pinata.cloud (free tier is sufficient).
# Used to upload ERC-8004 agent metadata to IPFS during registration.
# Get one at: https://app.pinata.cloud/developers/api-keys
PINATA_JWT=your_pinata_jwt_here


# ─── LLM ─────────────────────────────────────────────────────────────────────
# OpenAI API key from https://platform.openai.com/api-keys
# Embedded in every generated agent as the default LLM provider (GPT-4o-mini).
# Swap for another provider by editing src/agent.ts in the generated project.
OPENAI_API_KEY=sk-your_openai_api_key_here


# ─── RPC (optional) ──────────────────────────────────────────────────────────
# Custom RPC URL. If unset, agents fall back to public endpoints per chain.
# Recommended for production: use Alchemy, Infura, or QuickNode for reliability.
# Example (Arbitrum Sepolia via Alchemy):
# RPC_URL=https://arb-sepolia.g.alchemy.com/v2/your-api-key
