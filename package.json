{
    "name": "agenthub",
    "version": "1.0.0",
    "description": "Create, import, and orchestrate ERC-8004 AI agents with on-chain identity, reputation, and A2A communication.",
    "type": "module",
    "bin": {
        "agenthub": "./dist/index.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "tsx src/index.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "tsx tests/e2e-a2a-client.ts",
        "sync:skills": "tsx scripts/sync-skills.ts",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "erc-8004",
        "8004",
        "ai-agent",
        "a2a",
        "mcp",
        "x402",
        "ethereum",
        "arbitrum",
        "web3",
        "scaffold",
        "cli",
        "agenthub"
    ],
    "author": "Daniel Ortega",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/xdaniortega/agenthub.git"
    },
    "bugs": {
        "url": "https://github.com/xdaniortega/agenthub/issues"
    },
    "homepage": "https://github.com/xdaniortega/agenthub#readme",
    "dependencies": {
        "@blockbyvlog/agent0-sdk": "latest",
        "@solana/web3.js": "^1.98.0",
        "bs58": "^6.0.0",
        "chalk": "^5.3.0",
        "inquirer": "^9.2.23",
        "ora": "^8.0.1",
        "viem": "^2.21.0"
    },
    "devDependencies": {
        "@modelcontextprotocol/sdk": "^1.0.0",
        "@types/inquirer": "^9.0.7",
        "@types/node": "^20.10.0",
        "@x402/evm": "^2.2.0",
        "@x402/fetch": "^2.2.0",
        "dotenv": "^16.4.0",
        "tsx": "^4.7.0",
        "typescript": "^5.3.0",
        "vitest": "^2.0.0"
    },
    "engines": {
        "node": ">=18"
    }
}
